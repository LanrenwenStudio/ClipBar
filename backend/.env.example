# CLIProxyAPI management endpoint reachable from the container.
CLIPROXY_BASE_URL=http://192.168.1.3:8317
CLIPROXY_MANAGEMENT_KEY=replace-with-cliproxy-secret-key

# Separate token presented by ClipBar clients.
CLIPBAR_ACCESS_TOKEN=clipbar-kevin
CLIPBAR_PORT=8081
POLL_INTERVAL_SECONDS=600
# Optional persistent path inside the mounted data directory.
SETTINGS_PATH=/data/settings.json
